# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo
.vite/

# 运行期数据（数据库 / 语音缓存 / 日志 / 备份）——绝不进 git
server/data/
server/logs/
logs/
data/

# 密钥与部署环境
.env
.env.local
deploy/.env
deploy/offsite/

# HTTPS 自签证书（含私钥，绝不进 git；用 scripts/https-setup.ps1 在每台机器上自己生成）
server/certs/

# 测试残留
web/test/shots/
*.log
# 临时脚本/命令输出（根目录下的 _xxx.txt，如测试与 typecheck 回显）
/_*.txt

# 字体源文件（方正粗圆简体是商业字体，只作本地切片输入，随仓库外发即侵权）
# 切片产物 web/public/fonts/fzcuyuan/*.woff2 是要进镜像的，不在这里忽略。
/*.ttf
/*.otf

# 图标源图（AI 出的 2048px 大图，带水印，只作抠图输入）
# 抠好的 256px 透明底素材在 web/src/assets/icons/，那几张要进 git。
# 生成脚本：scripts/prepare-icons.py
/box.png
/tree.png
/jianba.png
/book.png

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 工具工作区（agent 本地记忆 / 任务数据，非项目代码）
.workbuddy/

# 测试运行时生成的临时配置（含测试密钥占位，勿入库）
server/config/config.*.yaml
!server/config/config.yaml
