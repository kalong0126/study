# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo
.vite/

# 运行期数据（数据库 / 语音缓存 / 日志 / 备份）——绝不进 git
server/data/
server/logs/
logs/
data/

# 密钥与部署环境
.env
.env.local
deploy/.env
deploy/offsite/

# 测试残留
web/test/shots/
*.log

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 工具工作区（agent 本地记忆 / 任务数据，非项目代码）
.workbuddy/

# 测试运行时生成的临时配置（含测试密钥占位，勿入库）
server/config/config.*.yaml
!server/config/config.yaml
