# =============================================================================
# 二年级快乐学习台 · 部署环境变量
# -----------------------------------------------------------------------------
# 用法：cp .env.example .env  然后填好带「必填」的项。
# .env 不要提交到 git（已在 .gitignore 里排除）。
# =============================================================================

# ------------------------------------------------------------------ 大模型（必填）
# 家庭内网走宽带出网，建议国内厂商。
# DeepSeek: https://platform.deepseek.com   （便宜、稳定）
# 月之暗面: https://platform.moonshot.cn
LLM_API_KEY=

# 留空则用 config.yaml 里的默认值 https://api.deepseek.com/v1
# 换厂商时才需要填，注意多数厂商要带 /v1（以对方文档为准）
LLM_BASE_URL=

# ------------------------------------------------- 多个模型：两个用途可以各配一套
#   story   生成童话    → 纯文本模型即可
#   suggest 组词建议    → 纯文本
#
# 只改模型名（同一家厂商）：
# LLM_STORY_MODEL=deepseek-chat
# LLM_SUGGEST_MODEL=deepseek-chat
#
# 不同厂商各用各的密钥：给某用途加 BASE_URL + API_KEY，留空则回落到上面的全局值。
# 例：故事用 DeepSeek，组词用月之暗面
# LLM_SUGGEST_MODEL=moonshot-v1-8k
# LLM_SUGGEST_BASE_URL=https://api.moonshot.cn/v1
# LLM_SUGGEST_API_KEY=
#
# 完整变量名（按需解开注释填写）：
# LLM_STORY_MODEL= / LLM_STORY_BASE_URL= / LLM_STORY_API_KEY=
# LLM_SUGGEST_MODEL= / LLM_SUGGEST_BASE_URL= / LLM_SUGGEST_API_KEY=

# ------------------------------------------------- 出图模型（阿里云百炼，必填）
# 语言强化「看图题」的配图用文生图模型（默认 qwen-image-plus），
# 走阿里云百炼接口，Key 和上面的文本模型**不通用**，要单独填。
# 阿里云百炼申请地址：https://bailian.console.aliyun.com
#
# 密钥必填（不填的话看图题会退回纯文字描述，页面提示去找家长配）：
IMAGEGEN_API_KEY=
#
# 接口地址：用百炼默认值就不用填（程序内置多模态生成接口地址）。
IMAGEGEN_BASE_URL=
#
# 模型名 / 输出尺寸 / 开关也可以用环境变量覆盖（不改 config.yaml 就用这里）：
# IMAGEGEN_MODEL=qwen-image-plus
# IMAGEGEN_SIZE=1328*1328
# IMAGEGEN_ENABLED=true

# ------------------------------------------------------------------ 数据库
# 本部署固定用 SQLite（单文件、零运维），不需要 MySQL。
# 数据文件落在 Docker 卷 app-data 里，自动备份生成在 ./data/backup。
DB_DRIVER=sqlite

# ------------------------------------------------------------------ 端口
# 对外访问端口：https://<这台机器的内网IP或域名>:8788
# ⚠️ app 容器用的是 **host 网络**（见 docker-compose.yml 的 network_mode），
#    所以这一项**就是实际监听端口**，没有「映射」这一层了 —— 改了它等于换访问端口
#    （防火墙 / 路由器里的端口转发也要跟着改）。
APP_PORT=8788
# 只有启用 proxy profile（nginx）时才用得上
HTTP_PORT=8080

# ------------------------------------------------------------------ 英文故事视频（Docker 必看）
# 孩子端「英文」页从这个目录里随机抽一集播放（完整看完 +10 分）。
#
# ⚠️ 容器看不到宿主机的路径，所以必须填**宿主机上已经挂好的那个目录**，否则容器里
#    根本没有这个路径，页面会报「目录不存在：/xxx」——而你在宿主机上明明能看到文件。
#
# 步骤：
#   1. 先在宿主机上把共享挂到本地（fnOS：文件管理 → 挂载 SMB；或系统里 mount -t cifs）
#   2. 确认宿主机上 `ls <挂载点>` 能看到 mp4，把挂载点填到下面
#   3. docker compose up -d      # 只改 .env 不用 --build
#
# 例：VIDEO_DIR_HOST=/vol02/1000-0-bfb475f2
# 留空/不填 → 容器里挂的是 deploy/video（空目录），页面提示「还没配置视频目录」，不报错。
#
# 非 Docker 部署（服务直接跑在 Windows 上）**不用管这一项**：
# 直接改 server/config/config.yaml 里的 video.dir 写 UNC 路径即可。
VIDEO_DIR_HOST=

# ------------------------------------------------------------------ 访问鉴权（上公网必填）
# 端口一旦能从公网访问，口令就是唯一那道门。
# 规则：内网照旧免口令（lanBypass）；公网必须输孩子口令才能用；
#       家长功能（内容后台 / 备份恢复 / 运行诊断 / 预生成音频）在公网一律 403。
#
# ⚠️ config.yaml 里带的默认口令是写在仓库里的，暴露公网前**务必换成自己的**。
#    8 位随机数字，生成一个：
#      node -e "console.log(String(Math.floor(Math.random()*1e8)).padStart(8,'0'))"
CHILD_PIN=
# 家长口令：**只能在家庭内网使用**，公网会被直接拒绝（不给猜解口）。
PARENT_PIN=

# ⚠️ Docker 部署**必须填这一项**：容器看到的来源地址是网桥网关（172.22.x）而不是
#    真实客户端，所以容器里只信任这里列出的网段，不写 = 家里每次打开也要输口令。
#    逗号分隔；IPv4 内网段和家里那个 IPv6 /64 都要写（公网访问走 IPv6）。
#    怎么查 IPv6 前缀：在 NAS 上 `ip -6 addr show scope global`，取 /64 那一段。
#    例：AUTH_LAN_CIDRS=172.10.10.0/24,2408:8352:a13:2cb1::/64
#
# ⚠️⚠️ 光填这一项还不够，**网络模式必须是 host**（docker-compose.yml 里已默认如此）：
#    bridge 模式下公网 IPv6 是 userland docker-proxy 转发的，容器看到的来源地址会变成
#    compose 网段的网关（实测 172.22.0.1）→ 真实客户端 IP 丢了 → 上面那个 IPv6 /64
#    **永远匹配不上**，家里照样被当公网。判断方法：看访问日志里的 ip 字段，
#    如果全是 172.22.0.1 这种网段网关地址，就说明踩了这个坑。
AUTH_LAN_CIDRS=

# ------------------------------------------------------------------ HTTPS
# 想让平板「添加到主屏幕」后没有浏览器地址栏 / 底栏（装成独立应用），必须开。
# 安卓 Chrome 只在安全上下文里才允许注册 Service Worker、才会把网页装成 WebAPK；
# 内网 HTTP 下「添加到主屏幕」只会变成普通书签。
#
# 证书往 server/certs/ 放 cert.pem + key.pem 两个文件（compose 里已默认挂好该目录）。
# 分两种情况：
#
# ① 纯内网用（访问 http://<内网IP>:8788）
#    → 用 mkcert 自签，另需一份 rootCA.crt（平板要装它才认）：
#      · 服务就跑在本机 Windows 上 → 仓库根跑 scripts/https-setup.ps1
#      · 服务在 NAS / Linux 上 → 该主机装 mkcert 自己签；或在 Windows 上签但把
#        该主机的内网 IP 写进 SAN（mkcert ... <NAS的IP> localhost 127.0.0.1）。
#        ⚠️ 签的必须是「平板要访问的那个 IP」，签错了平板照样提示不安全。
#      · 顺序必须是「先让平板装根证书，再开 HTTPS」：
#        平板打开 http://<IP>:8788/api/diag/rootca.crt 装上，然后才开 HTTPS。
#
# ② 有域名、要上公网（访问 https://<你的域名>:8788）
#    → **别用 mkcert**：自签证书在别人设备上必然警告，而且 SAN 里通常没有域名。
#      换成公信 CA 的证书（Let's Encrypt / 阿里云免费证书），放成同样的两个文件名，
#      之后**任何设备都不用装根证书**，浏览器也不再警告。
#      · 手动（90 天一次）：阿里云「数字证书管理服务 → 个人测试证书（原免费证书）」
#        申请单域名证书，下载 Nginx 版 → 得到 xxx.pem / xxx.key，
#        改名成 cert.pem / key.pem 覆盖到 server/certs/，然后
#        docker compose restart app
#      · 自动续期：跑 scripts/cert-acme.sh（DNS-01，不需要开 80/443）
#      ⚠️ 换了公网证书之后，用**内网 IP** 访问会重新报警（证书里没有那个 IP）——
#        内网也改用域名访问即可（域名解析到公网 IPv6，在家直连不走 NAT）。
#
# 改完：docker compose up -d（只改 .env 不用 --build；换了证书文件用 restart app）
# 证书不存在时会自动回退 HTTP（不会启动失败），启动日志里会给警告。
HTTPS_ENABLED=false
