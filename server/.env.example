# =============================================================================
# 二年级快乐学习台 · 本地运行配置
# -----------------------------------------------------------------------------
# 用法：把本文件复制成同目录下的 .env（即 server/.env），改完重启服务生效。
#   本项目会按 server/.env → 根目录 .env → deploy/.env 的顺序查找，
#   先找到的先赢；真实环境变量永远优先于这些文件。
#
# 这个文件不要提交到 git（已在 .gitignore 里排除）。
# =============================================================================

# ============================== 一、必填 =====================================
# 至少填一个能用的模型密钥。
# DeepSeek 申请地址：https://platform.deepseek.com   （便宜、稳定，推荐）
LLM_API_KEY=sk-在这里粘贴你的密钥

# 默认接口地址。用 DeepSeek 时可以不填（程序内置默认 https://api.deepseek.com/v1）。
# 换别家才需要填，注意多数厂商要带 /v1，以对方文档为准。
LLM_BASE_URL=

# ============================== 二、多个模型怎么配 ============================
# 本程序把大模型用在 3 个地方，可以各用一个模型，甚至来自不同厂商：
#
#   LLM_STORY_MODEL    生成童话      → 纯文本模型就行，挑便宜的
#   LLM_MARK_MODEL     手写判卷      → ⚠️ 必须支持「看图」（视觉/多模态），否则一定失败
#   LLM_SUGGEST_MODEL  组词建议      → 纯文本
#
# 三种典型配法，按需要选一种：
#
# ── 场景 A：全都用 DeepSeek（最省事）────────────────────────────────────────
#     注意：config.yaml 里判卷默认写的是 qwen-vl-max（阿里家的），
#     如果你的 baseUrl 是 DeepSeek，它会直接报 model not found（实测 400）。
#     这时把判卷也改成 deepseek-chat 即可 —— 实测它能正确识别图片。
# LLM_STORY_MODEL=deepseek-chat
# LLM_MARK_MODEL=deepseek-chat
# LLM_SUGGEST_MODEL=deepseek-chat

# ── 场景 B：同一家厂商，只是不同模型 ────────────────────────────────────────
#     只填模型名，baseUrl 和 key 继续共用上面的全局值。
# LLM_STORY_MODEL=deepseek-chat
# LLM_MARK_MODEL=qwen-vl-max
#
# ── 场景 C：不同厂商，各用各的密钥（最常见的真实需求）──────────────────────
#     给某个用途单独加 LLM_<用途>_BASE_URL 和 LLM_<用途>_API_KEY。
#     留空就自动回落到上面的全局 LLM_BASE_URL / LLM_API_KEY。
#
#     例如：故事用 DeepSeek，判卷用阿里云百炼（通义千问视觉模型）
# LLM_STORY_MODEL=deepseek-chat
#
# LLM_MARK_MODEL=qwen-vl-max
# LLM_MARK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MARK_API_KEY=sk-阿里的密钥
#
#     例如：组词也想用另一家（比如月之暗面）
# LLM_SUGGEST_MODEL=moonshot-v1-8k
# LLM_SUGGEST_BASE_URL=https://api.moonshot.cn/v1
# LLM_SUGGEST_API_KEY=sk-月之暗面的密钥

# ------------------------------ 常见厂商参数速查 ------------------------------
# 厂商            视觉模型            接口地址（base_url）
# DeepSeek        ✓ deepseek-chat     https://api.deepseek.com/v1
#                 （实测能识图：给纯红图答"红色"、纯蓝图答"蓝色"；
#                   deepseek-v4-pro / deepseek-flash 是推理型，不适合判卷）
# 阿里云百炼       ✓ qwen-vl-max       https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 GLM        ✓ glm-4v-plus        https://open.bigmodel.cn/api/paas/v4
# 月之暗面         ✓ moonshot-v1-8k-vision-preview  https://api.moonshot.cn/v1
# 火山方舟         ✓ doubao-1.5-vision-pro  https://ark.cn-beijing.volces.com/api/v3
# OpenAI          ✓ gpt-4o             https://api.openai.com/v1
#
# ⚠️ 踩坑提醒：模型名和厂商必须配套。把阿里的 qwen-vl-max 挂在 DeepSeek 的
#    接口地址上，一定会收到 400 model not found。服务启动时会自动检测并告警：
#    「判卷模型「xxx」看起来是 A 家的，但接口地址是 B 家」。
#
# 判断某家能不能判卷的最快办法：把它的接口地址填进 LLM_MARK_BASE_URL，
# 然后启动服务，看启动日志里「mark」那一行，或打开 诊断 → 真实调用测试。

# ============================== 三、数据库 ===================================
# sqlite：单文件、零运维，本地和家庭内网首选（默认，不用管下面几项）
# mysql ：需要先自己装好 MySQL 才用
# DB_DRIVER=sqlite
#
# 想用 MySQL 就把上一行改成 mysql 并填下面几项
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=grade2
# DB_USER=grade2
# DB_PASSWORD=

# ============================== 四、服务端口 =================================
# 浏览器访问 http://localhost:8788
# APP_PORT=8788

# ============================== 五、可选调优 =================================
# 想换朗读的声音或语速，改 server/config/config.yaml 里的 tts 段（不用在这里配）。
# 语速默认 -12%（小朋友听，放慢一点）；音色默认 zh-CN-XiaoyiNeural（女童音）。
