# =============================================================================
# 二年级快乐学习台 · 本地运行配置
# -----------------------------------------------------------------------------
# 用法：把本文件复制成同目录下的 .env（即 server/.env），改完重启服务生效。
#   本项目会按 server/.env → 根目录 .env → deploy/.env 的顺序查找，
#   先找到的先赢；真实环境变量永远优先于这些文件。
#
# 这个文件不要提交到 git（已在 .gitignore 里排除）。
# =============================================================================

# ============================== 一、必填 =====================================
# 至少填一个能用的模型密钥。
# DeepSeek 申请地址：https://platform.deepseek.com   （便宜、稳定，推荐）
LLM_API_KEY=sk-在这里粘贴你的密钥

# 默认接口地址。用 DeepSeek 时可以不填（程序内置默认 https://api.deepseek.com）。
# 换别家才需要填，注意多数厂商要带 /v1，以对方文档为准。
LLM_BASE_URL=

# ============================== 二、多个模型怎么配 ============================
# 本程序把文本大模型用在 2 个地方，可以各用一个模型，甚至来自不同厂商：
#
#   LLM_STORY_MODEL    生成童话      → 纯文本模型就行，挑便宜的
#   LLM_SUGGEST_MODEL  组词建议      → 纯文本
#
# 出图（语言强化看图题的配图）不在这一套里，单独走第六节的 IMAGEGEN_* 配置。
#
# ── 场景 A：全都用 DeepSeek（最省事）────────────────────────────────────────
# LLM_STORY_MODEL=deepseek-chat
# LLM_SUGGEST_MODEL=deepseek-chat
#
# ── 场景 B：不同厂商，各用各的密钥 ─────────────────────────────────────────
#     给某个用途单独加 LLM_<用途>_BASE_URL 和 LLM_<用途>_API_KEY。
#     留空就自动回落到上面的全局 LLM_BASE_URL / LLM_API_KEY。
#
#     例如：故事用 DeepSeek，组词用月之暗面
# LLM_STORY_MODEL=deepseek-chat
# LLM_SUGGEST_MODEL=moonshot-v1-8k
# LLM_SUGGEST_BASE_URL=https://api.moonshot.cn/v1
# LLM_SUGGEST_API_KEY=sk-月之暗面的密钥

# ============================== 三、出图模型（阿里云百炼）=====================
# 语言强化「看图题」的配图用文生图模型（默认 qwen-image-plus），
# 走阿里云百炼的接口，Key 和上面的文本模型**不通用**，要单独填。
# 阿里云百炼申请地址：https://bailian.console.aliyun.com
#
# 密钥必填（config.yaml 的 imagegen.apiKey 也行，写这里更方便）：
IMAGEGEN_API_KEY=
#
# 接口地址：用百炼默认值就不用填（程序内置多模态生成接口地址）。
IMAGEGEN_BASE_URL=
#
# 模型名 / 输出尺寸 / 开关也可以用环境变量覆盖（不改 config.yaml 就用这里）：
# IMAGEGEN_MODEL=qwen-image-plus
# IMAGEGEN_SIZE=1328*1328
# IMAGEGEN_ENABLED=true

# ============================== 四、数据库 ===================================
# sqlite：单文件、零运维，本地和家庭内网首选（默认，不用管下面几项）
# mysql ：需要先自己装好 MySQL 才用
# DB_DRIVER=sqlite
#
# 想用 MySQL 就把上一行改成 mysql 并填下面几项
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=grade2
# DB_USER=grade2
# DB_PASSWORD=

# ============================== 五、服务端口 =================================
# 浏览器访问 http://localhost:8788
# APP_PORT=8788

# ============================== 六、可选调优 =================================
# 英文故事视频目录（孩子端「英文」页从这里随机抽一集播放）。
# 本地直跑两种配法任选：
#   ① 直接改 server/config/config.yaml 里的 video.dir（Windows 填 UNC 路径）
#   ② 用环境变量 VIDEO_DIR 覆盖，例如：
# VIDEO_DIR=\\172.10.10.14\共享\视频
#
# ⚠️ Docker 部署不要在这里配 VIDEO_DIR：容器里看到的路径由 compose 挂载决定
#    （deploy/.env 里配 VIDEO_DIR_HOST 即可，VIDEO_DIR 已固定成 /app/server/video）。
#
# 想换朗读的声音或语速，改 server/config/config.yaml 里的 tts 段（不用在这里配）。
# 语速默认 -12%（小朋友听，放慢一点）；音色默认 zh-CN-XiaoyiNeural（女童音）。
