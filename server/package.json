{
  "name": "grade2-server",
  "private": true,
  "version": "1.0.0",
  "description": "二年级快乐学习台 · 后端服务（LLM / TTS / 数据 / 日志）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/api.test.ts",
    "test:auth": "tsx test/auth.test.ts",
    "test:mark": "tsx test/mark.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "msedge-tts": "^2.0.7",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "pinyin-pro": "^3.29.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
